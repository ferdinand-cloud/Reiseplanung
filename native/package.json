{
  "name": "reiseplan-native",
  "private": true,
  "version": "0.1.0",
  "description": "Gerüst für die iPhone-/Android-App (Capacitor). Die PWA im Hauptordner bleibt unverändert.",
  "type": "module",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && cap sync",
    "ios": "node scripts/copy-web.mjs && cap sync ios && cap open ios",
    "ios:lokal": "node scripts/copy-web.mjs && RP_LOKAL=1 cap sync ios && cap open ios",
    "android": "node scripts/copy-web.mjs && cap sync android && cap open android",
    "bilder": "node scripts/make-assets.mjs && capacitor-assets generate --iconBackgroundColor '#17212c' --iconBackgroundColorDark '#17212c' --splashBackgroundColor '#17212c' --splashBackgroundColorDark '#17212c'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3"
  }
}
